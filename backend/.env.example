# Citezy Backend Environment Variables

# Nebius Token Factory / NVIDIA Nemotron Settings
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.ai/v1
NEMOTRON_MODEL_ID=nvidia/nemotron-4-340b-instruct

# Tavily Search API
TAVILY_API_KEY=your_tavily_api_key_here

# Server Configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Execution Limits
MAX_SOURCES=8
MAX_CLAIMS=25
MAX_EXECUTION_TIMEOUT_SECONDS=180
